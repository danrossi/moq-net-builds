{
  "extends": "./moq/js/tsconfig.json",
  "compilerOptions": {
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "preserve",
    //"allowSyntheticDefaultImports": true,
    "outDir": "dist",
    "rootDir": "./",
    "types": ["vite/client"],
    "paths": {
      "@moq/video": ["./moq/js/video/src/"],
      "@moq/net": ["./moq/js/net/src"],
      "@moq/net/connection": ["./moq/js/net/src/connection"],
      "@moq/watch": ["./moq/js/watch/src"],
      "@moq/watch/ui": ["./moq/js/watch/src/ui/element"],
      "@moq/watch/ui/element": ["./moq/js/watch/src/ui/element"],
      "@moq/watch/element": ["./moq/js/watch/src/element"],
      "@moq/watch/support/element": ["./moq/js/watch/src/support/element"],

      "@moq/publish": ["./moq/js/publish/src"],
      "@moq/signals": ["./moq/js/signals/src/"],
      "@moq/clock": ["./moq/js/clock/src/"],
      "@moq/hang": ["./moq/js/hang/src/"],
      "@moq/hang/catalog": ["./moq/js/hang/src/catalog/"],
      "@moq/hang/container": ["./moq/js/hang/src/container/"],
      "@moq/msf": ["./moq/js/msf/src"],
      "@moq/ui-core": ["./moq/js/ui-core/src/"],
      "@moq/json": ["./moq/js/json/src/"],

      "@moq/publish/element": ["./moq/js/publish/src/element"],
      "@moq/publish/ui": ["./moq/js/publish/src/ui/element"],
      "@moq/publish/support/element": ["./moq/js/publish/src/support/element"],
      "@moq/libav": ["./moq/js/libav/"]
    }
  },
  "include": ["src", "./moq/js/common/worklet.d.ts"]
}
